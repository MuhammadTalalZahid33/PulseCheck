// PulseCheck data model.
//
// Prisma 7 notes:
//  - generator provider is `prisma-client` (not `prisma-client-js`) and `output` is required.
//  - the datasource URL is supplied by ../prisma.config.ts, not by env() here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Result of a single probe, and the last known state of a monitor.
enum MonitorStatus {
  up
  down
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  monitors Monitor[]
}

model Monitor {
  id              String         @id @default(cuid())
  userId          String
  name            String
  url             String
  intervalMinutes Int            @default(5)
  expectedStatus  Int            @default(200)
  timeoutMs       Int            @default(5000)
  isActive        Boolean        @default(true)
  lastCheckedAt   DateTime?
  lastStatus      MonitorStatus?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks    Check[]
  incidents Incident[]

  // Dashboard reads: "all monitors for this user".
  @@index([userId])
  // Engine reads: "which active monitors are due for a check".
  @@index([isActive, lastCheckedAt])
}

model Check {
  id             String        @id @default(cuid())
  monitorId      String
  status         MonitorStatus
  statusCode     Int?
  responseTimeMs Int?
  error          String?
  checkedAt      DateTime      @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Every chart query and uptime aggregate is a window scan on this index.
  @@index([monitorId, checkedAt])
}

model Incident {
  id              String    @id @default(cuid())
  monitorId       String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Incident timeline, newest first.
  @@index([monitorId, startedAt])
  // NOTE: a partial unique index enforcing "at most one OPEN incident per monitor"
  // is added by raw SQL in the migration (Prisma cannot express partial indexes).
  // See prisma/migrations/*/migration.sql.
}
