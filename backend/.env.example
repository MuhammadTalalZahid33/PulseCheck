# ============================================================================
# PulseCheck backend configuration
#
# Copy to .env and fill in. Booleans accept true/false/1/0/yes/no.
# Anything invalid stops the process at boot with a message naming the field.
# ============================================================================

NODE_ENV=development
PORT=4000

# ---- Database (required) ---------------------------------------------------
# Prisma Postgres / Neon / Supabase / any Postgres. Remote hosts need SSL.
DATABASE_URL="postgresql://user:password@host:5432/pulsecheck?sslmode=require"
# Local Postgres (check the port — a PG 18 install may sit on 5433):
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5433/pulsecheck?schema=public"
#
# After changing this, apply the schema:  npm run db:migrate -w backend

# ---- Auth (required) ------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d
COOKIE_NAME=pulsecheck_token

# ---- Cache (optional) -----------------------------------------------------
# Leave blank to run without caching: dashboard reads go straight to Postgres.
# Set it and dashboard caching turns on with no code changes. Must start with
# redis:// or rediss:// — a typo fails at boot rather than silently disabling.
#
#   Local:    redis://localhost:6379
#   Upstash:  rediss://default:YOUR_PASSWORD@YOUR-ENDPOINT.upstash.io:6379
#             (Upstash requires the rediss:// scheme for TLS)
REDIS_URL=
CACHE_TTL_SECONDS=30
# Confirm with: curl http://localhost:4000/api/health  ->  "cache":"connected"

# ---- Monitoring engine ----------------------------------------------------
ENGINE_ENABLED=true
ENGINE_CONCURRENCY=10
# A monitoring tool fetches user-supplied URLs, which is SSRF by design.
#   true  = monitors may target localhost/private IPs (self-hosted, single user)
#   false = the probe resolves the hostname and refuses private, loopback,
#           link-local and CGNAT addresses. Use this for public signups.
ALLOW_PRIVATE_TARGETS=true

# ---- Email alerts (optional) ----------------------------------------------
# While MAIL_ENABLED=false, alerts are logged instead of sent:
#   [mail] disabled, would have sent "[PulseCheck] DOWN: My Site" to you@...
#
# To turn real alerts on, set MAIL_ENABLED=true and fill in the rest. The
# credentials are checked at boot; a bad host or password is reported straight
# away instead of going unnoticed until a real outage.
#
# Mailtrap (dev inbox — Sandbox > Integrations > SMTP):
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
#   MAIL_USER / MAIL_PASS from that page
#
# Gmail / SES / Postmark etc: use port 465 for implicit TLS, or 587 for STARTTLS.
MAIL_ENABLED=false
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="PulseCheck <alerts@pulsecheck.local>"
# Confirm with: curl http://localhost:4000/api/health   ->  "mail":"ready"
# Then send yourself a sample pair (signed in):
#   POST /api/alerts/test

# ---- Frontend ------------------------------------------------------------
# Used for the "View monitor" link in alert emails.
APP_BASE_URL=http://localhost:3000
