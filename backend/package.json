{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:start": "pg_ctl -D ../.pgdata -o \"-p 5544 -c listen_addresses=127.0.0.1\" -l ../.pgdata/server.log start",
    "db:stop": "pg_ctl -D ../.pgdata -m fast stop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.4",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "node-cron": "4.6.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.15.6",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
